    {
      "name": "Q6 - PATCH Update",
      "item": [
        {
          "name": "Patch User Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status field updated\", function () {\r",
                  "    pm.expect(\r",
                  "        jsonData.data.status\r",
                  "    ).to.eql(\"Active\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Only one field sent in request\", function () {\r",
                  "    const requestBody = JSON.parse(pm.request.body.raw);\r",
                  "\r",
                  "    pm.expect(\r",
                  "        Object.keys(requestBody.data).length\r",
                  "    ).to.eql(1);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
