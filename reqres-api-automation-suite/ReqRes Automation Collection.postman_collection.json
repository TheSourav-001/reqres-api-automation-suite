    {
      "name": "Q4 - GET User",
      "item": [
        {
          "name": "Get User Records",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response contains data\", function () {\r",
                  "    pm.expect(jsonData.data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Name matched\", function () {\r",
                  "    pm.expect(\r",
                  "        jsonData.data[0].data.name\r",
                  "    ).to.eql(\"Sourav Dipto Apu\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email matched\", function () {\r",
                  "    pm.expect(\r",
                  "        jsonData.data[0].data.email\r",
                  "    ).to.eql(\"sourav@gmail.com\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Role matched\", function () {\r",
                  "    pm.expect(\r",
                  "        jsonData.data[0].data.role\r",
                  "    ).to.eql(\"Student(OSTAD-QA)\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "X-Reqres-Env",
                "value": "{{env}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/collections/{{collectionSlug}}/records?project_id={{projectId}}&x-api-key={{apiKey}}&X-Reqres-Env={{env}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "collections",
                "{{collectionSlug}}",
                "records"
              ],
              "query": [
                {
                  "key": "project_id",
                  "value": "{{projectId}}"
                },
                {
                  "key": "x-api-key",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "X-Reqres-Env",
                  "value": "{{env}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
