      "item": [
        {
          "name": "Request Magic Link (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{publicKey}}",
                "type": "text"
              },
              {
                "key": "X-Reqres-Env",
                "value": "{{env}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"nt9693707@gmail.com\",\r\n  \"project_id\": \"{{projectId}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/app-users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "app-users",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Verify Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "console.log(jsonData);\r",
                  "\r",
                  "pm.environment.set(\r",
                  "    \"sessionToken\",\r",
                  "    jsonData.data.session_token\r",
                  ");\r",
                  "\r",
                  "pm.test(\"Session token generated\", function () {\r",
                  "    pm.expect(\r",
                  "        jsonData.data.session_token\r",
                  "    ).to.not.be.undefined;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Reqres-Env",
                "value": "{{env}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"token\": \"81360801\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/app-users/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "app-users",
                "verify"
              ]
            }
          },
          "response": []
        }
      ]
